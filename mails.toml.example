# Example mails configuration.
#
# Copy this file next to the mails binary as `mails.toml`, then run:
#   mails keygen
#   mails encrypt --account work --write
#   mails check

[general]
# Process mail that already exists when a mailbox is first watched, that is, on
# the first connection of a run. A reconnect resumes where the last one stopped.
# Leave this false unless you really want to run rules against the whole mailbox.
startup_sync = false
# Re-enter IDLE this often; server-side idle limits are typically 30 minutes.
idle_timeout = "29m"
# First reconnect delay; doubles up to five minutes.
reconnect_delay = "30s"
# Fetch at most this many bytes of each message body.
max_body_bytes = 262144
# Default timeout for rule commands.
command_timeout = "30s"
# Default truncation for {{body}} / MAILS_BODY.
body_chars = 4000
# Encryption key file, relative to this file. Never commit it.
env_file = ".env"
key_env = "MAILS_KEY"

[[rules]]
name = "urgent"
keywords = ["urgent", "invoice", "payment due"]
fields = ["subject", "body"]
match = "any"
case_sensitive = false
regex = false
# Shell string, run with `sh -c`. Use {{subject_q}} or $MAILS_SUBJECT when the
# subject reaches a shell.
command = 'notify-send "Mail from {{from}}" "{{subject}}"'
timeout = "10s"
# body_chars = 500
# accounts = ["work"]
# mailboxes = ["INBOX"]

[[rules]]
name = "from-boss"
keyword = "boss@example.com"
fields = ["from"]
exec = ["/usr/local/bin/on-boss-mail", "--subject", "{{subject_q}}"]

# IMAP hosts for common providers (all use SSL on port 993):
#   Gmail / Workspace   imap.gmail.com          (App Password required)
#   Outlook / M365      outlook.office365.com   (OAuth2 ONLY, basic auth disabled)
#   Yahoo               imap.mail.yahoo.com      (App Password required)
#   iCloud              imap.mail.me.com         (app-specific password)
#   Fastmail            imap.fastmail.com
#   Proton (Bridge)     127.0.0.1 port 1143      (tls_verify = false)
#   Zoho                imap.zoho.com
#   GMX                 imap.gmx.com
# --- OAuth2 accounts (Outlook / Microsoft 365 / Gmail) -----------------------
#
# Microsoft disabled password (basic) authentication for IMAP, and Google
# requires OAuth2 too, so `password` cannot be used for those accounts. Set
# `auth = "xoauth2"` instead: `mails login` prints a URL and a short code, you
# approve it on any device (phone, another machine) and no browser is needed on
# the server. The refresh token is stored next to this file.
#
# [accounts.outlook]
# host = "outlook.office365.com"
# port = 993
# username = "me@outlook.com"
# auth = "xoauth2"
# oauth_provider = "microsoft"        # or "google" or "custom"
# # oauth_tenant = "consumers"        # default "common"; use your tenant id for work accounts
# oauth_client_id = "YOUR-APP-CLIENT-ID"
# # oauth_token_file = ".outlook.oauth"   # default: .<account name>.oauth
# mailboxes = ["INBOX"]
#
# # Google equivalent:
# oauth_provider = "google"
# oauth_scope = "https://mail.google.com/"
#
# # Any other provider that supports the device grant (RFC 8628):
# oauth_provider = "custom"
# oauth_device_endpoint = "https://example.com/device/code"
# oauth_token_endpoint = "https://example.com/token"
# oauth_scope = "imap"
#
# The client id must be registered as a *public* client with the device code
# flow enabled. For Microsoft, register an app in Entra ID, add the delegated
# permission "IMAP.AccessAsUser.All" (Office 365 Exchange Online) and enable
# "Allow public client flows". Anyone can sign in with their own account; the
# refresh token never leaves this machine.

[accounts.work]
host = "imap.example.com"
port = 993
username = "me@example.com"
# Written by `mails encrypt --account work --write`.
password = ""
mailboxes = ["INBOX"]
tls = true
tls_verify = true
# Per-account overrides of [general]:
# startup_sync = true
# idle_timeout = "10m"
# reconnect_delay = "1m"
# max_body_bytes = 1048576

# Account-specific rules run after the global ones.
# [[accounts.work.rules]]
# name = "deploys"
# keywords = ["deploy", "rollback"]
# fields = ["subject"]
# command = 'logger -t deploys "$MAILS_SUBJECT"'
