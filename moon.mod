name = "kupas/mails"

version = "0.1.3"

readme = "README.md"

repository = "https://github.com/tomasky/mails"

license = "Apache-2.0"

keywords = [ "imap", "mail", "notify", "idle", "watch", "moonbit" ]

description = "Watch IMAP mailboxes and run commands when a message matches a keyword rule"

preferred_target = "native"

import {
  "moonbitlang/async@0.22.4",
  "cc06b/mooncry@0.95.0",
  "moonbit-community/toml@0.5.0",
}
